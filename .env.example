# Copie para .env (na raiz do projeto) e preencha com as credenciais do Dashboard da Pluggy.
# O .env está no .gitignore: as credenciais ficam só no seu PC, nunca no navegador nem no GitHub.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Opcionais
# PORT=3333
# DB_PATH=./data/financas.db
# SYNC_DIAS_INICIAIS=365
# De quantas em quantas horas conferir se algum banco atualizou e sincronizar só ele (0 desliga)
# SYNC_AUTO_HORAS=3
# Pasta das cópias automáticas da base, de preferência em outro disco (barras normais). Sem isto: copias/ ao lado da base.
# COPIAS_DIR=C:/Users/voce/sis-financas-copias
# Endereço público de um túnel (ex.: Cloudflare Tunnel) que pode gravar. Só com login na frente (Cloudflare Access):
# sem isso, qualquer um na internet edita seus dados. O túnel precisa reescrever o Host para meu-financeiro.localhost.
# ORIGEM_EXTERNA=https://financeiro.seudominio.com
